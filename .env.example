NODE_ENV=development
PORT=3000
HOST=0.0.0.0
STORAGE_DRIVER=mongo
MONGO_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/community_hub?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-VERCEL-DOMAIN.vercel.app
TRUST_PROXY=true
BOOTSTRAP_ADMIN_EMAIL=your-admin-google-email@example.com
# Netlify backend only: paste the full Firebase service-account JSON as one-line JSON.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
VERIFICATION_THRESHOLD=2
MAX_POLL_DURATION_HOURS=720
CHAT_MAX_LENGTH=500
CHAT_HISTORY_LIMIT=50
CHAT_RETENTION=2000
