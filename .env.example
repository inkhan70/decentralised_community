# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
NODE_ENV=production

# Interface to bind. 0.0.0.0 (default) makes the server reachable from other
# devices on your network (LAN IP), not just localhost. Use 127.0.0.1 to
# restrict access to this machine only.
HOST=0.0.0.0

# Optional: shown at startup and nowhere else. Set this to your public
# domain/IP when deployed behind a reverse proxy, load balancer, or tunnel.
PUBLIC_URL=

# Optional secret used only when creating the first administrator account.
# Enter it in the registration form's admin setup key field, then remove it
# from deployment environment after the administrator has been created.
ADMIN_SETUP_KEY=

# Generate a long, random secret, e.g.: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Storage: choose ONE of the two flows below --------------------------
#
# "mongo" (default): use MongoDB — either a remote cluster (Atlas) or a
#   MongoDB instance running on your own machine/network. Set MONGO_URI
#   accordingly in either case; a self-hosted local Mongo just uses a
#   mongodb://127.0.0.1:27017/... URI instead of a mongodb+srv:// Atlas one.
#
# "local": zero-setup file-based storage. No database server required —
#   data is persisted to a JSON file on disk at LOCAL_DB_PATH. Great for a
#   quick demo, offline use, or a single-machine deployment.
STORAGE_DRIVER=local

# Used when STORAGE_DRIVER=mongo. Examples:
#   Remote (Atlas):  mongodb+srv://<user>:<pass>@cluster0.mongodb.net/community_hub?retryWrites=true&w=majority
#   Local MongoDB:   mongodb://127.0.0.1:27017/community_hub
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/community_hub?retryWrites=true&w=majority

# Used when STORAGE_DRIVER=local. Defaults to ./data/community-db.json if unset.
LOCAL_DB_PATH=./data/community-db.json

# Comma-separated list of allowed browser origins for CORS, e.g.:
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Leave as * for local/LAN use or when the bundled frontend (served by this
# same app) is the only client — it's always same-origin either way.
ALLOWED_ORIGINS=https://decentralised-community.vercel.app,https://decentralised-community.netlify.app

BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# --- Reverse proxy ---------------------------------------------------------
# Set when running behind nginx / Caddy / a load balancer / a tunnel, so rate
# limiting and logs see the real client IP instead of the proxy's. Number of
# proxy hops (e.g. 1), "true", or a subnet. Leave empty when exposed directly.
TRUST_PROXY=

# --- Community rules --------------------------------------------------------
# How many OTHER members must endorse a contribution before it counts towards
# the Nation Balance and the contributor's balance. 0 = trust-based: everything
# counts immediately (the behaviour before v1.2).
VERIFICATION_THRESHOLD=2
# Longest a poll may stay open, in hours (default 30 days). 0 = no limit.
MAX_POLL_DURATION_HOURS=720
# How often expired polls are closed and announced (milliseconds, min 1000).
POLL_SWEEP_INTERVAL_MS=15000

# --- Real-time abuse protection --------------------------------------------
# Each socket may send SOCKET_RATE_BURST events at once, refilled at
# SOCKET_RATE_PER_SEC per second.
SOCKET_RATE_BURST=10
SOCKET_RATE_PER_SEC=2

# --- Chat -------------------------------------------------------------------
CHAT_MAX_LENGTH=500
CHAT_HISTORY_LIMIT=50
# Messages kept per channel; older ones are deleted.
CHAT_RETENTION=2000

# Firebase Admin SDK service-account JSON (server only; never put in frontend or Git)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Exact verified Google email allowed to become the initial Super Admin
BOOTSTRAP_ADMIN_EMAIL=
